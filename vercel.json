{
  "version": 2,
  "name": "nigeria-incident-map",
  "rewrites": [
    {
      "source": "/",
      "destination": "/nigeria_map copy.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000"
        }
      ]
    }
  ]
}
